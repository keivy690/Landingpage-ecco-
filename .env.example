# Google Tag Manager (opcional - para rastreamento de analíticas)
# Exemplo: GTM-XXXXXXX
VITE_GTM_ID=

# Google Analytics 4 Measurement ID (opcional)
# Exemplo: G-XXXXXXXXXX
VITE_GA4_ID=

# Alternativa ao VITE_GA4_ID (usado pelo conector Lovable)
VITE_LOVABLE_CONNECTOR_GOOGLE_ANALYTICS_API_KEY=

# Host de preview do Lovable (usado apenas em ambiente Lovable)
# LOVABLE_PREVIEW_HOST=
